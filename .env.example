# Copia este archivo como .env (nunca subas .env al repositorio).
# En Docker Compose estas variables ya vienen definidas en docker-compose.yml.

# local | test | prod
APP_ENV=local
LOG_LEVEL=INFO

# Local: Postgres del docker-compose.
# Prod (Supabase): Project Settings -> Database -> Connection string -> "Session pooler" (puerto 5432).
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://redfacyt:redfacyt@localhost:5432/redfacyt

# Local: Redis del docker-compose. Prod (Upstash): rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Solo en local (el frontend de Vite en otro puerto). En prod se deja vacío: Vercel hace de proxy.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
# Dirección del frontend: enlace y QR de la tarjeta para Instagram (M6)
PUBLIC_WEB_URL=http://localhost:5173

# Prod: genera uno con  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=solo-para-desarrollo-local-no-usar-en-produccion
ACCESS_TOKEN_MINUTES=15
# F1.6: la sesión vence tras 8 h sin uso y nunca dura más de 7 días.
REFRESH_TOKEN_HOURS=8
SESSION_MAX_DAYS=7

# Archivos subidos (fotos de perfil, imágenes). local = carpeta backend/media, servida en
# /api/v1/media. Prod: supabase, con Project Settings -> API Keys -> Secret key (sb_secret_...).
STORAGE_BACKEND=local
STORAGE_BUCKET=media
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
